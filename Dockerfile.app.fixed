FROM php:8.2-fpm-alpine

# 必要なパッケージとPHP拡張機能をインストール
RUN apk add --no-cache \
    mysql-client \
    redis \
    libzip-dev \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev \
    oniguruma-dev \
    supervisor \
    autoconf \
    g++ \
    make \
    bash \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install \
        pdo \
        pdo_mysql \
        mysqli \
        opcache \
        pcntl \
        bcmath \
        gd \
        zip \
        mbstring

# Redis拡張機能
RUN pecl install redis \
    && docker-php-ext-enable redis \
    && apk del autoconf g++ make

# Composerインストール
COPY --from=composer:2.6 /usr/bin/composer /usr/bin/composer

# 作業ディレクトリ設定
WORKDIR /var/www/html

# アプリケーションファイルをコピー
COPY . .

# Composer依存関係インストール
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Laravel最適化（本番用） - ビルド時は設定キャッシュなし（ランタイムで動的実行）
RUN php artisan config:clear \
    && php artisan route:clear \
    && php artisan view:clear

# 権限設定
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html/storage \
    && chmod -R 755 /var/www/html/bootstrap/cache

# 起動スクリプト作成（ランタイムでキャッシュを動的生成）
RUN echo '#!/bin/bash' > /usr/local/bin/start.sh \
    && echo 'set -e' >> /usr/local/bin/start.sh \
    && echo '' >> /usr/local/bin/start.sh \
    && echo '# Laravel設定の最適化（ランタイム時）' >> /usr/local/bin/start.sh \
    && echo 'cd /var/www/html' >> /usr/local/bin/start.sh \
    && echo 'php artisan config:cache' >> /usr/local/bin/start.sh \
    && echo 'php artisan route:cache' >> /usr/local/bin/start.sh \
    && echo 'php artisan view:cache' >> /usr/local/bin/start.sh \
    && echo '' >> /usr/local/bin/start.sh \
    && echo '# PHP-FPM開始' >> /usr/local/bin/start.sh \
    && echo 'exec php-fpm' >> /usr/local/bin/start.sh \
    && chmod +x /usr/local/bin/start.sh

# PHP-FPM設定
COPY docker/app/php-fpm.conf /usr/local/etc/php-fpm.d/www.conf
COPY docker/app/php.ini /usr/local/etc/php/conf.d/mobile-order.ini

# 実行ユーザー
USER www-data

EXPOSE 9000

# 修正版起動コマンド（ランタイムで設定キャッシュを生成してからPHP-FPM開始）
CMD ["/usr/local/bin/start.sh"]